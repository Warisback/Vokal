# Vokal laptop server -- example environment.
#
#   copy .env.example .env        (Windows)
#   cp   .env.example .env        (bash)
#
# Every value below is optional: the defaults are what the demo actually runs
# with. .env is gitignored.
#
# THERE ARE NO SECRETS IN THIS FILE, and there is no line you could add to put
# one here. Speech to text (faster-whisper) and text to speech (Piper) both run
# locally on this laptop. No API key, no account, no network call, and no voice
# is ever cloned -- nothing a user says leaves the machine. That is a product
# decision, not a shortcut: the people Vokal is for should not have to trust a
# cloud with the only voice they have left.


# ---------------------------------------------------------------------------
# server
# ---------------------------------------------------------------------------

# Bind address and port. PROTOCOL.md fixes these: 0.0.0.0:8000, plain HTTP.
# The laptop's LAN IP goes in firmware/secrets.h as VOKAL_HOST.
VOKAL_BIND_HOST=0.0.0.0
VOKAL_PORT=8000

# 1 = canned captions, canned delay, no models loaded, no audio device. Lets
# the firmware be integrated against a real server before the AI stack is up.
# `python server.py --fake` does the same thing.
VOKAL_FAKE=0

# Write every received utterance to laptop/captures/ as a WAV. Costs nothing
# and you cannot re-press a moment on stage, so leave it on.
VOKAL_SAVE_CAPTURES=1


# ---------------------------------------------------------------------------
# text to speech -- Piper, local
# ---------------------------------------------------------------------------

# Where the .onnx voices live. Deliberately OUTSIDE the repo: this project sits
# under a long OneDrive path, and OneDrive corrupts the model files it syncs.
PIPER_VOICE_DIR=C:\vokal-venv\voices

# Voice name without the extension. Resolved to <PIPER_VOICE_DIR>\<name>.onnx,
# with the matching .onnx.json expected beside it. If it is missing, the server
# still boots and /health names the exact path it looked for and lists what is
# actually in the directory.
#
# On this laptop:
#   en_GB-cori-high                    chosen by ear. 0.83 s to first audio.
#   en_GB-alba-medium                  faster (0.13 s), a little flatter.
#   en_GB-northern_english_male-medium
#   en_US-lessac-medium
#
# The *-medium voices are ~6x cheaper to synthesise. If the room's laptop is
# slower than ours, switch to alba-medium and lose almost nothing.
PIPER_VOICE=en_GB-cori-high


# ---------------------------------------------------------------------------
# speech to text -- faster-whisper, local
# ---------------------------------------------------------------------------

# small.en int8 on CPU measured RTF 0.103 here: 6.2 s of compute for a 60 s
# clip, well inside the budget in PROTOCOL.md. base.en is ~2x faster and
# noticeably worse on quiet speech, which is exactly the audio that matters.
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Greedy. Beam search buys very little on single short utterances and costs
# time we have promised the board.
WHISPER_BEAM_SIZE=1

# There is deliberately NO initial-prompt setting. We measured it on the real
# demo audio: an initial_prompt made Whisper emit the prompt text itself as a
# fake transcript segment AND drop thirty seconds of real speech. VAD is off for
# the same class of reason -- it trims quiet speech, and quiet speech is the
# entire point of this product. See the comments in pipeline.py.


# ---------------------------------------------------------------------------
# playback
# ---------------------------------------------------------------------------

# Milliseconds buffered before the speaker starts. Piper streams well ahead of
# real time, so this only covers the first synthesis chunk. Paid once per
# phrase. Raise it if you hear a click or a stutter at the start of a sentence.
VOKAL_PREBUFFER_MS=120

# Force an output device: an integer index, or a substring of the device name
# (e.g. "Speakers"). Empty = the system default output. Set this if the laptop
# is plugged into a PA and Windows keeps choosing the laptop's own speakers.
VOKAL_OUTPUT_DEVICE=
