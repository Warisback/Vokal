# Copy to server/.env (ignored by git) and fill in what you use. npm start reads it.
# Leave the language model settings empty to run without suggestions.

VOKAL_LLM_PROVIDER=        # google (default) or openai-compatible
VOKAL_LLM_MODEL=           # google default gemma-4-26b-a4b-it; required for openai-compatible
GOOGLE_API_KEY=            # for google
VOKAL_LLM_BASE_URL=        # for openai-compatible, e.g. http://127.0.0.1:8080/v1 (llama.cpp or Ollama)
VOKAL_LLM_API_KEY=         # for openai-compatible, optional for local servers
VOKAL_LLM_TIMEOUT_MS=      # default 45000, allowed 1000 to 45000
VOKAL_ALLOWED_ORIGINS=     # comma-separated exact origins allowed by CORS, e.g. https://warisback.github.io
VOKAL_ACCESS_TOKEN=        # at least 24 characters; required for any request not from this computer
PORT=                      # default 3210
