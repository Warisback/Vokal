#pragma once
// =====================================================================
//  display.h -- LovyanGFX device setup for the three board modes.
//  Exposes a single global: `tft`.
// =====================================================================
#include "config.h"

#define LGFX_USE_V1

#if BOARD_TYPE == BOARD_AUTODETECT
  // ---- Let LovyanGFX identify the board at runtime ------------------
  #define LGFX_AUTODETECT
  #include <LovyanGFX.hpp>
  #include <LGFX_AUTODETECT.hpp>
  static LGFX tft;

#else
  #include <LovyanGFX.hpp>

  // ---- Manual configuration ----------------------------------------
  #if BOARD_TYPE == BOARD_CYD_2432S028
    // Sunton ESP32-2432S028R ("cheap yellow display").
    // Display and touch sit on SEPARATE SPI buses -- that is the thing
    // people get wrong. Verify against your board before trusting it.
    #define PANEL_DRIVER   Panel_ILI9341
    #define PIN_TFT_SCLK   14
    #define PIN_TFT_MOSI   13
    #define PIN_TFT_MISO   12
    #define PIN_TFT_DC      2
    #define PIN_TFT_CS     15
    #define PIN_TFT_RST    -1
    #define PIN_TFT_BL     21
    #define TFT_WIDTH     240
    #define TFT_HEIGHT    320
    #define TFT_INVERT    false
    #define TFT_RGB_ORDER false
    #define TOUCH_ENABLED  1
    #define TOUCH_XPT2046  1
    #define TOUCH_FT5X06   2
    #define TOUCH_GT911    3
    #define TOUCH_DRIVER   TOUCH_XPT2046
    #define PIN_TCH_SCLK   25
    #define PIN_TCH_MOSI   32
    #define PIN_TCH_MISO   39
    #define PIN_TCH_CS     33
    #define PIN_TCH_IRQ    36
  #endif

  class LGFX_Manual : public lgfx::LGFX_Device {
    lgfx::PANEL_DRIVER  _panel;
    lgfx::Bus_SPI       _bus;
    lgfx::Light_PWM     _light;
  #if TOUCH_ENABLED
    #if   TOUCH_DRIVER == TOUCH_FT5X06
      lgfx::Touch_FT5x06 _touch;
    #elif TOUCH_DRIVER == TOUCH_GT911
      lgfx::Touch_GT911  _touch;
    #else
      lgfx::Touch_XPT2046 _touch;
    #endif
  #endif
  public:
    LGFX_Manual() {
      { auto c = _bus.config();
        c.spi_host    = SPI2_HOST;      // HSPI
        c.spi_mode    = 0;
        c.freq_write  = 40000000;
        c.freq_read   = 16000000;
        c.spi_3wire   = false;
        c.use_lock    = true;
        c.dma_channel = SPI_DMA_CH_AUTO;
        c.pin_sclk    = PIN_TFT_SCLK;
        c.pin_mosi    = PIN_TFT_MOSI;
        c.pin_miso    = PIN_TFT_MISO;
        c.pin_dc      = PIN_TFT_DC;
        _bus.config(c);
        _panel.setBus(&_bus);
      }
      { auto c = _panel.config();
        c.pin_cs          = PIN_TFT_CS;
        c.pin_rst         = PIN_TFT_RST;
        c.pin_busy        = -1;
        c.panel_width     = TFT_WIDTH;
        c.panel_height    = TFT_HEIGHT;
        c.memory_width    = TFT_WIDTH;
        c.memory_height   = TFT_HEIGHT;
        c.offset_x        = 0;
        c.offset_y        = 0;
        c.offset_rotation = 0;
        c.readable        = true;
        c.invert          = TFT_INVERT;
        c.rgb_order       = TFT_RGB_ORDER;
        c.dlen_16bit      = false;
        c.bus_shared      = false;
        _panel.config(c);
      }
      { auto c = _light.config();
        c.pin_bl      = PIN_TFT_BL;
        c.invert      = false;
        c.freq        = 44100;
        c.pwm_channel = 7;
        _light.config(c);
        _panel.setLight(&_light);
      }
  #if TOUCH_ENABLED
      { auto c = _touch.config();
        c.bus_shared = false;
        c.offset_rotation = 0;   // 0-7: covers rotation AND mirroring
      #if TOUCH_DRIVER == TOUCH_FT5X06 || TOUCH_DRIVER == TOUCH_GT911
        // Capacitive: I2C, and coordinates come out in pixels already.
        c.x_min = 0;  c.x_max = TFT_WIDTH  - 1;
        c.y_min = 0;  c.y_max = TFT_HEIGHT - 1;
        c.i2c_port = 1;
        c.i2c_addr = TCH_I2C_ADDR;
        c.pin_sda  = PIN_TCH_SDA;
        c.pin_scl  = PIN_TCH_SCL;
        c.pin_int  = PIN_TCH_IRQ;
        c.freq     = 400000;
      #else
        // Resistive: raw ADC range, not pixels. Run Calib on the device
        // and paste the printed numbers in here.
        c.x_min = 300;  c.x_max = 3900;
        c.y_min = 300;  c.y_max = 3900;
        c.spi_host = SPI3_HOST;   // separate bus from the panel
        c.freq     = 1000000;
        c.pin_sclk = PIN_TCH_SCLK;
        c.pin_mosi = PIN_TCH_MOSI;
        c.pin_miso = PIN_TCH_MISO;
        c.pin_cs   = PIN_TCH_CS;
        c.pin_int  = PIN_TCH_IRQ;
      #endif
        _touch.config(c);
        _panel.setTouch(&_touch);
      }
  #endif
      setPanel(&_panel);
    }
  };
  static LGFX_Manual tft;
#endif

// Guaranteed-correct RGB565, no library colour macros needed.
#define RGB565(r,g,b) ((uint16_t)((((r)&0xF8)<<8)|(((g)&0xFC)<<3)|((b)>>3)))

static const uint16_t C_BG     = RGB565(  8, 12, 20);
static const uint16_t C_PANEL  = RGB565( 24, 30, 44);
static const uint16_t C_TEXT   = RGB565(232,236,244);
static const uint16_t C_MUTED  = RGB565(128,138,158);
static const uint16_t C_ACCENT = RGB565( 74,160,255);
static const uint16_t C_OK     = RGB565( 64,200,128);
static const uint16_t C_WARN   = RGB565(240,176, 64);
static const uint16_t C_ERR    = RGB565(240, 88, 88);

static int SCR_W = 320;
static int SCR_H = 240;

inline void displayBegin() {
  tft.init();
  tft.setRotation(SCREEN_ROTATION);
  tft.setBrightness(BACKLIGHT_LEVEL);
  tft.fillScreen(C_BG);
  SCR_W = tft.width();
  SCR_H = tft.height();
  Serial.printf("[disp] %dx%d rot=%d touch=%d\n",
                SCR_W, SCR_H, SCREEN_ROTATION, (int)tft.touch());
}

// Run once per board if touch lands in the wrong place. Prints the
// calibration values -- paste them into the _touch config above so you
// never have to do it again.
inline void displayCalibrateTouch() {
  if (!tft.touch()) { Serial.println("[disp] no touch device"); return; }
  uint16_t cal[8];
  tft.fillScreen(C_BG);
  tft.setTextColor(C_TEXT, C_BG);
  tft.setTextDatum(textdatum_t::middle_center);
  tft.drawString("Touch the corner arrows", SCR_W / 2, SCR_H / 2);
  tft.calibrateTouch(cal, C_TEXT, C_BG, (SCR_W > SCR_H ? SCR_W : SCR_H) >> 3);
  Serial.print("[disp] touch cal = { ");
  for (int i = 0; i < 8; i++) Serial.printf("%d%s", cal[i], i < 7 ? ", " : " ");
  Serial.println("}");
}
