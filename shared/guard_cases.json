{
  "about": "Shared cases for the hallucination guard. app/js/guard.js and python/vokal/guard.py must both pass every case in this file. Text cases give the raw transcript, the text that should survive, and what was removed and by which rule, in input order. Utterance cases add the model's no-speech score. Level and pre-check cases cover the check that runs before any model call. Edit this file only together with both guards.",
  "version": 2,
  "constants": {
    "filler_phrases": [
      "thank you",
      "thanks for watching",
      "please subscribe",
      "you",
      "bye",
      "thanks",
      "thank you for watching",
      "subscribe",
      "goodbye"
    ],
    "credit_substrings": ["subtitles by", "amara.org", "www."],
    "no_speech_prob_max": 0.6,
    "min_seconds": 0.3,
    "min_level_dbfs": -60,
    "silence_level_dbfs": -120,
    "level_frame_ms": 30
  },
  "rules": {
    "no_words": "The sentence has no letters or digits once punctuation and symbols are removed (for example '...' or a run of music notes). The whole sentence is removed.",
    "annotation": "Whisper writes non-speech as tags: anything in square brackets such as [Music] or [BLANK_AUDIO], anything in round brackets such as (laughs), and music notes. Each tag is removed wherever it appears and reported on its own. If nothing with letters or digits is left, the whole sentence is removed and reported once instead.",
    "credit_line": "The lower-cased sentence contains a credit substring. Whisper copies these from subtitle credits in its training data. The sentence is removed wherever it appears.",
    "filler": "The normalised sentence is exactly a filler phrase and it is at the end of the text. Removal repeats from the end, so a transcript that is only filler becomes empty. Filler at the start or in the middle is kept.",
    "no_speech": "The model's no-speech score for the recording is above no_speech_prob_max. Everything is removed and reported as one entry. A missing score (null) skips this rule.",
    "too_short": "The recording is shorter than min_seconds. No model call is made.",
    "no_signal": "Every sample is exactly zero, so the level is silence_level_dbfs. Usually a muted microphone, or one in use by another app or a phone call. No model call is made.",
    "too_quiet": "The loudest 30 ms frame is quieter than min_level_dbfs. No model call is made."
  },
  "text_cases": [
    { "id": "empty", "input": "", "expected": "", "removed": [] },
    { "id": "spaces-only", "input": "   ", "expected": "", "removed": [] },
    { "id": "mixed-whitespace-only", "input": " \t\n  ", "expected": "", "removed": [] },

    { "id": "filler-you-with-leading-space", "input": " you", "expected": "", "removed": [{ "text": "you", "rule": "filler" }], "note": "Whisper's usual output for silence." },
    { "id": "filler-thank-you", "input": "Thank you.", "expected": "", "removed": [{ "text": "Thank you.", "rule": "filler" }], "note": "Seen in v1 on trailing silence. A person who really says only 'Thank you' loses it too; the app asks 'Did you say ...?' or offers 'Use it anyway'." },
    { "id": "filler-thanks-for-watching", "input": "Thanks for watching!", "expected": "", "removed": [{ "text": "Thanks for watching!", "rule": "filler" }] },
    { "id": "filler-please-subscribe", "input": "Please subscribe.", "expected": "", "removed": [{ "text": "Please subscribe.", "rule": "filler" }] },
    { "id": "filler-bye", "input": "Bye.", "expected": "", "removed": [{ "text": "Bye.", "rule": "filler" }] },
    { "id": "filler-thanks", "input": "Thanks.", "expected": "", "removed": [{ "text": "Thanks.", "rule": "filler" }] },
    { "id": "filler-thank-you-for-watching", "input": "Thank you for watching.", "expected": "", "removed": [{ "text": "Thank you for watching.", "rule": "filler" }] },
    { "id": "filler-subscribe", "input": "Subscribe!", "expected": "", "removed": [{ "text": "Subscribe!", "rule": "filler" }] },
    { "id": "filler-goodbye", "input": "Goodbye.", "expected": "", "removed": [{ "text": "Goodbye.", "rule": "filler" }] },
    { "id": "filler-repeated", "input": "Thank you. Thank you.", "expected": "", "removed": [{ "text": "Thank you.", "rule": "filler" }, { "text": "Thank you.", "rule": "filler" }] },

    { "id": "credit-amara-line", "input": "Subtitles by the Amara.org community", "expected": "", "removed": [{ "text": "Subtitles by the Amara.org community", "rule": "credit_line" }] },
    { "id": "credit-amara-alone", "input": "Amara.org", "expected": "", "removed": [{ "text": "Amara.org", "rule": "credit_line" }], "note": "v1's laptop pipeline never caught this, because it removed the dot before checking." },
    { "id": "credit-www-drops-real-url", "input": "Go to www.example.com.", "expected": "", "removed": [{ "text": "Go to www.example.com.", "rule": "credit_line" }], "note": "Known cost: a spoken web address is removed. The app lists it under 'What was heard' with 'Use it anyway'." },

    { "id": "norm-upper-case", "input": "THANK YOU", "expected": "", "removed": [{ "text": "THANK YOU", "rule": "filler" }] },
    { "id": "norm-upper-you", "input": "YOU!", "expected": "", "removed": [{ "text": "YOU!", "rule": "filler" }] },
    { "id": "norm-hyphen-and-marks", "input": "thank-you!!!", "expected": "", "removed": [{ "text": "thank-you!!!", "rule": "filler" }] },
    { "id": "norm-ellipsis-character", "input": "Thank you…", "expected": "", "removed": [{ "text": "Thank you…", "rule": "filler" }] },
    { "id": "norm-loose-spacing", "input": "  Thank   you .  ", "expected": "", "removed": [{ "text": "Thank you .", "rule": "filler" }] },
    { "id": "norm-inverted-exclamation", "input": "¡Bye!", "expected": "", "removed": [{ "text": "¡Bye!", "rule": "filler" }] },

    { "id": "trailing-thank-you", "input": "I want water. Thank you.", "expected": "I want water.", "removed": [{ "text": "Thank you.", "rule": "filler" }], "note": "The app shows 'Removed at the end: Thank you.' with 'Add back'." },
    { "id": "trailing-thanks-for-watching", "input": "Can you open the window? Thanks for watching!", "expected": "Can you open the window?", "removed": [{ "text": "Thanks for watching!", "rule": "filler" }] },
    { "id": "trailing-two-fillers", "input": "I need help. Thank you. Bye.", "expected": "I need help.", "removed": [{ "text": "Thank you.", "rule": "filler" }, { "text": "Bye.", "rule": "filler" }] },
    { "id": "trailing-you-without-punctuation", "input": "My back hurts. You", "expected": "My back hurts.", "removed": [{ "text": "You", "rule": "filler" }] },
    { "id": "trailing-credit-line", "input": "Please turn the light off. Subtitles by the Amara.org community", "expected": "Please turn the light off.", "removed": [{ "text": "Subtitles by the Amara.org community", "rule": "credit_line" }] },
    { "id": "trailing-filler-on-new-line", "input": "I want water\nThank you", "expected": "I want water", "removed": [{ "text": "Thank you", "rule": "filler" }], "note": "A line break always ends a sentence." },
    { "id": "trailing-filler-after-crlf", "input": "I want water.\r\nThank you.", "expected": "I want water.", "removed": [{ "text": "Thank you.", "rule": "filler" }] },
    { "id": "trailing-filler-then-annotation", "input": "I need help. Thank you. [Music]", "expected": "I need help.", "removed": [{ "text": "Thank you.", "rule": "filler" }, { "text": "[Music]", "rule": "annotation" }] },
    { "id": "trailing-curly-apostrophe-kept", "input": "I don’t want it. Thanks!", "expected": "I don’t want it.", "removed": [{ "text": "Thanks!", "rule": "filler" }], "note": "Kept text is not rewritten: the curly apostrophe stays." },

    { "id": "keep-leading-filler", "input": "Thank you. Could I have some water?", "expected": "Thank you. Could I have some water?", "removed": [], "note": "Only filler at the end is removed." },
    { "id": "keep-middle-filler", "input": "Hello. Thank you. I'm fine.", "expected": "Hello. Thank you. I'm fine.", "removed": [] },
    { "id": "middle-credit-line-removed", "input": "I'm fine. Subtitles by the Amara.org community. See you later.", "expected": "I'm fine. See you later.", "removed": [{ "text": "Subtitles by the Amara.org community.", "rule": "credit_line" }] },

    { "id": "keep-thank-you-for-the-tea", "input": "Thank you for the tea.", "expected": "Thank you for the tea.", "removed": [] },
    { "id": "keep-i-love-you", "input": "I love you.", "expected": "I love you.", "removed": [] },
    { "id": "keep-thanks-comma", "input": "Thanks, that's lovely.", "expected": "Thanks, that's lovely.", "removed": [] },
    { "id": "keep-bye-for-now", "input": "Bye for now, see you tomorrow.", "expected": "Bye for now, see you tomorrow.", "removed": [] },
    { "id": "keep-subscribe-me", "input": "Can you subscribe me to the newsletter?", "expected": "Can you subscribe me to the newsletter?", "removed": [] },
    { "id": "keep-thank-you-very-much", "input": "Thank you very much.", "expected": "Thank you very much.", "removed": [] },
    { "id": "keep-thank-you-after-comma", "input": "I want water, thank you.", "expected": "I want water, thank you.", "removed": [], "note": "Same sentence as real speech, so it is not filler." },
    { "id": "keep-you-too", "input": "You too.", "expected": "You too.", "removed": [] },
    { "id": "keep-goodbye-mum", "input": "Goodbye, Mum.", "expected": "Goodbye, Mum.", "removed": [] },
    { "id": "keep-youth-club", "input": "Youth club is on Tuesday.", "expected": "Youth club is on Tuesday.", "removed": [] },
    { "id": "keep-double-thank-you", "input": "Thank you, thank you.", "expected": "Thank you, thank you.", "removed": [] },
    { "id": "keep-no-space-after-full-stop", "input": "I want water.Thank you.", "expected": "I want water.Thank you.", "removed": [], "note": "A sentence ends only at . ! ? or an ellipsis followed by whitespace, or at a line break." },
    { "id": "keep-domain-without-www", "input": "The website is nhs.uk.", "expected": "The website is nhs.uk.", "removed": [] },
    { "id": "keep-smiley-without-bracket-pair", "input": "I'm happy :)", "expected": "I'm happy :)", "removed": [], "note": "A tag needs an opening and a closing bracket." },

    { "id": "no-words-dots", "input": "...", "expected": "", "removed": [{ "text": "...", "rule": "no_words" }] },
    { "id": "no-words-music-notes", "input": "♪♪♪", "expected": "", "removed": [{ "text": "♪♪♪", "rule": "no_words" }] },
    { "id": "no-words-after-speech", "input": "I'm here. ...", "expected": "I'm here.", "removed": [{ "text": "...", "rule": "no_words" }] },

    { "id": "annotation-blank-audio", "input": "[BLANK_AUDIO]", "expected": "", "removed": [{ "text": "[BLANK_AUDIO]", "rule": "annotation" }], "note": "whisper.cpp prints this for silence." },
    { "id": "annotation-round-brackets", "input": "(upbeat music)", "expected": "", "removed": [{ "text": "(upbeat music)", "rule": "annotation" }] },
    { "id": "annotation-two-notes", "input": "[Music] [Applause].", "expected": "", "removed": [{ "text": "[Music] [Applause].", "rule": "annotation" }], "note": "Only tags and punctuation: the whole sentence is reported once." },
    { "id": "annotation-tags-and-punctuation-only", "input": "[Music], ♪!", "expected": "", "removed": [{ "text": "[Music], ♪!", "rule": "annotation" }] },
    { "id": "annotation-before-speech", "input": "[Music] I want water.", "expected": "I want water.", "removed": [{ "text": "[Music]", "rule": "annotation" }], "note": "Text-to-speech would otherwise say 'Music, I want water'." },
    { "id": "annotation-music-notes-around-speech", "input": "♪ I want water ♪", "expected": "I want water", "removed": [{ "text": "♪", "rule": "annotation" }, { "text": "♪", "rule": "annotation" }] },
    { "id": "annotation-round-brackets-before-speech", "input": "(laughs) I want water.", "expected": "I want water.", "removed": [{ "text": "(laughs)", "rule": "annotation" }] },
    { "id": "annotation-before-full-stop", "input": "I want water [Music].", "expected": "I want water.", "removed": [{ "text": "[Music]", "rule": "annotation" }], "note": "The space before a tag goes with it." },
    { "id": "annotation-in-middle", "input": "I want [inaudible] water.", "expected": "I want water.", "removed": [{ "text": "[inaudible]", "rule": "annotation" }] },
    { "id": "annotation-then-trailing-filler", "input": "I want water. [Music] Thank you.", "expected": "I want water.", "removed": [{ "text": "[Music]", "rule": "annotation" }, { "text": "Thank you.", "rule": "filler" }], "note": "The tag is removed first, then what is left of the sentence is filler at the end." },
    { "id": "annotation-then-credit-line", "input": "[Music] Subtitles by the Amara.org community", "expected": "", "removed": [{ "text": "[Music]", "rule": "annotation" }, { "text": "Subtitles by the Amara.org community", "rule": "credit_line" }] },

    { "id": "whitespace-collapsed", "input": "  I   want  water.  ", "expected": "I want water.", "removed": [] },
    { "id": "whitespace-no-break-and-ideographic-space", "input": "I want water.　Thank you.", "expected": "I want water.", "removed": [{ "text": "Thank you.", "rule": "filler" }], "note": "Whitespace is the JavaScript \\s set, written out in full so Python matches it." },
    { "id": "whitespace-next-line-is-not-space", "input": "I want water.\u0085Thank you.", "expected": "I want water.\u0085Thank you.", "removed": [], "note": "U+0085 is whitespace to Python's \\s but not to JavaScript's, so it is not in the shared set." },
    { "id": "unicode-composed", "input": "Café please.", "expected": "Café please.", "removed": [], "note": "Text is NFC-normalised first, so both languages compare the same characters." },

    { "id": "non-english-spanish", "input": "¿Dónde está el baño?", "expected": "¿Dónde está el baño?", "removed": [] },
    { "id": "non-english-german", "input": "Ich möchte Wasser, bitte.", "expected": "Ich möchte Wasser, bitte.", "removed": [] },
    { "id": "non-english-japanese", "input": "水をください。", "expected": "水をください。", "removed": [], "note": "The ideographic full stop does not split sentences." },
    { "id": "non-english-russian-thanks", "input": "Спасибо.", "expected": "Спасибо.", "removed": [], "note": "Only the English filler phrases are listed." },

    { "id": "digits-only", "input": "5.", "expected": "5.", "removed": [] },
    { "id": "digits-in-speech", "input": "Room 12, please.", "expected": "Room 12, please.", "removed": [] }
  ],
  "utterance_cases": [
    { "id": "score-null-uses-text-rules", "text": " you", "no_speech_prob": null, "expected": "", "removed": [{ "text": "you", "rule": "filler" }], "note": "The probe failed, so only the text rules run." },
    { "id": "score-at-max-kept", "text": "I want water.", "no_speech_prob": 0.6, "expected": "I want water.", "removed": [] },
    { "id": "score-over-max-dropped", "text": "I want water.", "no_speech_prob": 0.6001, "expected": "", "removed": [{ "text": "I want water.", "rule": "no_speech" }] },
    { "id": "silence-you-dropped-by-score", "text": " you", "no_speech_prob": 0.9036, "expected": "", "removed": [{ "text": "you", "rule": "no_speech" }], "note": "Measured: tiny.en on 3 s of digital silence." },
    { "id": "noise-you-dropped-by-score", "text": " You", "no_speech_prob": 0.6583, "expected": "", "removed": [{ "text": "You", "rule": "no_speech" }], "note": "Measured: tiny.en on 3 s of uniform noise at -38.7 dBFS." },
    { "id": "single-word-kept", "text": " No.", "no_speech_prob": 0.1095, "expected": "No.", "removed": [], "note": "Measured: the highest single-word score on tiny.en (synthetic 'No.' in -50 dBFS noise)." },
    { "id": "low-score-trailing-filler", "text": " I want water. Thank you.", "no_speech_prob": 0.01, "expected": "I want water.", "removed": [{ "text": "Thank you.", "rule": "filler" }] },
    { "id": "dropped-text-is-tidied", "text": "  I want\nwater.  ", "no_speech_prob": 0.9, "expected": "", "removed": [{ "text": "I want water.", "rule": "no_speech" }], "note": "The reported text is NFC with whitespace collapsed to single spaces and trimmed." },
    { "id": "empty-text-high-score", "text": "", "no_speech_prob": 0.95, "expected": "", "removed": [] },
    { "id": "whitespace-text-high-score", "text": " \n ", "no_speech_prob": 0.95, "expected": "", "removed": [] }
  ],
  "level_cases": [
    { "id": "empty", "rate": 16000, "samples": 0, "bursts": [], "expected_dbfs": -120 },
    { "id": "digital-silence", "rate": 16000, "samples": 48000, "bursts": [], "expected_dbfs": -120 },
    { "id": "full-scale", "rate": 16000, "samples": 16000, "bursts": [{ "start": 0, "length": 16000, "amplitude": 1.0 }], "expected_dbfs": 0 },
    { "id": "one-quiet-word-in-long-hold", "rate": 16000, "samples": 480000, "bursts": [{ "start": 160000, "length": 8000, "amplitude": 0.005623413 }], "expected_dbfs": -45, "note": "0.5 s at -45 dBFS inside a 30 s hold. Whole-clip RMS would be about -62.8 dBFS and would wrongly fail the -60 floor." },
    { "id": "frames-are-fixed-not-sliding", "rate": 16000, "samples": 960, "bursts": [{ "start": 240, "length": 480, "amplitude": 0.1 }], "expected_dbfs": -23.0103, "note": "Frames start at sample 0 and do not overlap, so a burst across a frame boundary is split between two frames." },
    { "id": "clip-shorter-than-one-frame", "rate": 16000, "samples": 100, "bursts": [{ "start": 0, "length": 100, "amplitude": 0.1 }], "expected_dbfs": -20 },
    { "id": "frame-length-follows-rate", "rate": 48000, "samples": 48000, "bursts": [{ "start": 0, "length": 1440, "amplitude": 0.01 }], "expected_dbfs": -40, "note": "At 48 kHz a frame is 1440 samples." }
  ],
  "precheck_cases": [
    { "id": "normal-speech", "duration_s": 5.24, "level_dbfs": -11.5, "expected": null, "note": "Measured on the synthetic 5.24 s sentence fixture. Its whole-clip RMS is -20.6 dBFS." },
    { "id": "quiet-noise-passes", "duration_s": 3.0, "level_dbfs": -38.3, "expected": null, "note": "Measured on the generated test noise (uniform, peak 0.02, whole-clip RMS -38.7 dBFS). Room noise passes this check. The model's no-speech score handles it." },
    { "id": "long-hold-one-quiet-word", "duration_s": 30.0, "level_dbfs": -45, "expected": null, "note": "See level case one-quiet-word-in-long-hold." },
    { "id": "at-min-length", "duration_s": 0.3, "level_dbfs": -30, "expected": null },
    { "id": "under-min-length", "duration_s": 0.29, "level_dbfs": -30, "expected": "too_short" },
    { "id": "at-quiet-floor", "duration_s": 2.0, "level_dbfs": -60, "expected": null },
    { "id": "under-quiet-floor", "duration_s": 2.0, "level_dbfs": -60.01, "expected": "too_quiet" },
    { "id": "just-above-digital-silence", "duration_s": 2.0, "level_dbfs": -119.99, "expected": "too_quiet" },
    { "id": "digital-silence", "duration_s": 3.0, "level_dbfs": -120, "expected": "no_signal" },
    { "id": "short-and-silent", "duration_s": 0.1, "level_dbfs": -120, "expected": "too_short", "note": "Length is checked first." },
    { "id": "zero-length", "duration_s": 0, "level_dbfs": -120, "expected": "too_short" }
  ]
}
